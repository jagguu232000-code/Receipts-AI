# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY_HERE"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="your-app-url-here"  # e.g. "https://receipts-ai-abc123.uc.r.appspot.com"

# GUMROAD_PRODUCT_ID: The permalink/slug of your Gumroad product to verify licenses against server-side.
GUMROAD_PRODUCT_ID="your-gumroad-product-id-here"  # e.g. "lifetime-pro" or "1234567890"

# GOOGLE_CLIENT_ID: The OAuth Client ID obtained from the Google Cloud Console.
GOOGLE_CLIENT_ID=""

# GOOGLE_CLIENT_SECRET: The OAuth Client Secret obtained from the Google Cloud Console.
GOOGLE_CLIENT_SECRET=""

# VITE_GUMROAD_PRODUCT_URL: The client-side direct purchase URL (e.g. from your Gumroad share options)
# This will be used as the destination when users click "Purchase Lifetime Pro".
VITE_GUMROAD_PRODUCT_URL="your-gumroad-product-url-here"  # e.g. "https://gumroad.com/lifetime-pro"

# Optional SMTP Configuration for live automated emails
# If SMTP keys are empty, Receipts AI gracefully falls back to local simulation logs
# inside `simulated_emails.json`. Licenses can be instantly activated using 
# the built-in Sandbox Simulator in the paywall modal or using "GUMROAD-TEST-ACTIVE-KEY" / "DEMO-LICENSE-KEY".
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""

